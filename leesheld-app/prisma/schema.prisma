generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  displayName  String
  passwordHash String
  role         String   // PARENT or CHILD
  parentId     String?
  parent       User?    @relation("Family", fields: [parentId], references: [id], onDelete: Cascade)
  children     User[]   @relation("Family")
  lessons      Lesson[]
  assignedLessons Lesson[] @relation("AssignedLessons")
  attempts     Attempt[]
  createdAt    DateTime @default(now())
  @@index([parentId])
  @@index([role])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  topic       String
  level       String   // Makkelijk, Gemiddeld, Moeilijk
  icon        String   @default("📘")
  minutes     Int      @default(6)
  text        String   @db.Text
  questions   Json
  published   Boolean  @default(true)
  global      Boolean  @default(false)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo  User?    @relation("AssignedLessons", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  attempts    Attempt[]
  @@index([ownerId, published])
  @@index([assignedToId, published])
  @@index([global, published])
}

model Attempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score       Int
  correct     Int
  total       Int
  level       String
  topic       String
  answers     Json
  createdAt   DateTime @default(now())
  @@index([userId, createdAt])
  @@index([userId, topic])
}
